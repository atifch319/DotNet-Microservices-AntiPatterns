# Copy to .env for Docker Compose. .env is gitignored.
# These are development placeholders, not production secrets.

SQL_SA_PASSWORD=DevOnly_ChangeMe1!
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Host ports. SQL Server is published on 14333 so an existing local instance on 1433 is left alone.
# SQLSERVER_HOST_PORT=14333
# RABBITMQ_HOST_PORT=5672
# RABBITMQ_UI_PORT=15672
# ORDER_HOST_PORT=5001
# INVENTORY_HOST_PORT=5002
# PAYMENT_HOST_PORT=5003
# NOTIFICATION_HOST_PORT=5004
